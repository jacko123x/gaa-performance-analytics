# Application identity
APP_ENV=development
APP_TITLE=Austin Stacks Performance Platform
TEAM_NAME=Austin Stacks
SEASON_LABEL=Club Championship 2026

# Local PostgreSQL connection
DATABASE_URL=postgresql+psycopg://gaa_admin:change-this-local-password@localhost:5432/gaa_analytics
INITIAL_SHARED_PASSWORD=change-this-shared-password

# SQLAlchemy connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
SQL_ECHO=false
LOG_LEVEL=INFO
JSON_LOGS=true

# Local Docker PostgreSQL values
POSTGRES_DB=gaa_analytics
POSTGRES_USER=gaa_admin
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

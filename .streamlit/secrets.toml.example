# Copy these values into your hosting provider's Streamlit secrets panel.
# Never rename this file to secrets.toml and commit the populated version.

APP_ENV = "production"
APP_TITLE = "Austin Stacks Performance Platform"
TEAM_NAME = "Austin Stacks"
SEASON_LABEL = "Club Championship 2026"

DATABASE_URL = "postgresql+psycopg://user:password@host:5432/database?sslmode=require"
INITIAL_SHARED_PASSWORD = "replace-with-a-long-random-password"

DB_POOL_SIZE = 5
DB_MAX_OVERFLOW = 10
DB_POOL_RECYCLE_SECONDS = 1800
DB_CONNECT_TIMEOUT_SECONDS = 10
SQL_ECHO = false
LOG_LEVEL = "INFO"
JSON_LOGS = true
